<Project>
  <Target Name="RemoveTransientCompilerMetadata" AfterTargets="Build">
    <ItemGroup>
      <TransientCompilerMetadata Include="$(IntDir)**\*.obj.dt.d.json" />
      <TransientCompilerMetadata Include="$(IntDir)**\*.obj.dt.module.json" />
      <TransientCompilerMetadata Include="$(IntDir)**\*.obj.dt.module.json.command" />
      <TransientCompilerMetadata Include="$(IntDir)**\*.idb" />
      <TransientCompilerMetadata Include="$(IntDir)**\*.vcxproj.FileListAbsolute.txt" />
    </ItemGroup>
    <Delete Files="@(TransientCompilerMetadata)" />
  </Target>
</Project>
